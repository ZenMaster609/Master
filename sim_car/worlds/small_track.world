<sdf version='1.6'>
  <world name='small_track'>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-40 40 20 0 0.667643 -1</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- WORLD SETINGS -->
    <scene>
      <background>0.68 0.80 0.94 1.0</background>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <shadows>false</shadows>
      <sky>
        <clouds>
          <speed>6</speed>
          <direction>0.0</direction>
          <humidity>0.3</humidity>
          <mean_size>0.4</mean_size>
        </clouds>
      </sky>
    </scene>

    <spherical_coordinates>
      <!-- currently gazebo has a bug: instead of outputing lat, long, altitude in ENU
      (x = East, y = North and z = Up) as the default configurations, it's outputting (-E)(-N)U,
      therefore we rotate the default frame 180 so that it would go back to ENU -->
      <heading_deg>180</heading_deg>

      <!-- Appleton Tower coordinates -->
      <latitude_deg>55.944400</latitude_deg>
      <longitude_deg>-3.18629</longitude_deg>
    </spherical_coordinates>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- MODELS -->
    <include>
      <uri>model://asphalt_plane</uri>
      <pose>0.0 0.0 0.0 0 0 0</pose>
    </include>

    <include>
      <uri>model://small_track</uri>
      <pose>0 0 0.5 0 0 0</pose>
    </include>

    <model name='small_track_backdrop'>
      <static>true</static>
      <link name='visuals'>
        <visual name='front_wall'>
          <pose>35 0 13 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 60 26</size>
            </box>
          </geometry>
          <material>
            <ambient>0.40 0.56 0.78 1</ambient>
            <diffuse>0.40 0.56 0.78 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <visual name='rear_wall'>
          <pose>-35 0 13 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 60 26</size>
            </box>
          </geometry>
          <material>
            <ambient>0.46 0.60 0.70 1</ambient>
            <diffuse>0.46 0.60 0.70 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <visual name='left_wall'>
          <pose>0 30 13 0 0 0</pose>
          <geometry>
            <box>
              <size>70 0.2 26</size>
            </box>
          </geometry>
          <material>
            <ambient>0.34 0.52 0.40 1</ambient>
            <diffuse>0.34 0.52 0.40 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <visual name='right_wall'>
          <pose>0 -30 13 0 0 0</pose>
          <geometry>
            <box>
              <size>70 0.2 26</size>
            </box>
          </geometry>
          <material>
            <ambient>0.34 0.52 0.40 1</ambient>
            <diffuse>0.34 0.52 0.40 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <visual name='landmark_tower_left'>
          <pose>18 22 10 0 0 0</pose>
          <geometry>
            <box>
              <size>8 8 20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.46 0.30 1</ambient>
            <diffuse>0.62 0.46 0.30 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <visual name='landmark_tower_right'>
          <pose>-14 -22 8 0 0 0</pose>
          <geometry>
            <box>
              <size>7 7 16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.58 0.44 0.34 1</ambient>
            <diffuse>0.58 0.44 0.34 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

  </world>
</sdf>
