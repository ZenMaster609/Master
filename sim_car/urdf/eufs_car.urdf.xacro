<?xml version="1.0"?>
<robot name="eufs" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="config_file" default=""/>
  <xacro:arg name="chassis_mesh" default="file://$(find sim_car)/meshes/sisu-20d.dae"/>
  <xacro:arg name="topic_prefix" default="/sim/raw"/>
  <xacro:arg name="publish_track_cones" default="true"/>
  <xacro:arg name="enable_cone_miscoloring" default="false"/>
  <xacro:arg name="cone_confusion_yaml" default="$(find gazebo_cone_plugins)/config/cone_confusion_matrix.yaml"/>

  <xacro:property name="config" value="${load_yaml('$(arg config_file)')}"/>

  <material name="tire_mat">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>

  <xacro:include filename="$(find sim_car)/urdf/eufs_base.urdf.xacro"/>
  <xacro:include filename="$(find sim_car)/urdf/eufs_wheels.urdf.xacro"/>

  <xacro:eufs_base chassis_mesh="$(arg chassis_mesh)"/>
  <xacro:wheels chassis_width="${config['kinematics']['axle_width']}" wheelbase="${config['kinematics']['l']}"/>

  <!-- IMU Sensor Link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.03 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- GPS Sensor Link -->
  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="chassis"/>
    <child link="gps_link"/>
    <origin xyz="-0.5 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Stereo Camera Links -->
  <link name="stereo_left_link">
    <visual>
      <geometry>
        <box size="0.04 0.03 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="stereo_left_joint" type="fixed">
    <parent link="chassis"/>
    <child link="stereo_left_link"/>
    <origin xyz="1.71 0.06 0.2" rpy="0 0 0"/>
  </joint>

  <link name="stereo_right_link">
    <visual>
      <geometry>
        <box size="0.04 0.03 0.02"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="stereo_right_joint" type="fixed">
    <parent link="chassis"/>
    <child link="stereo_right_link"/>
    <origin xyz="1.71 -0.06 0.2" rpy="0 0 0"/>
  </joint>

  <!-- 2D LiDAR Sensor Link -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="1.45 0 -0.09" rpy="0 0 0"/>
  </joint>

  <!-- EUFS dynamics plugin (gz-sim) -->
  <gazebo>
    <plugin filename="libeufs_gz_dynamics.so" name="eufs_gz_dynamics::EufsRaceCarModel">
      <vehicle_model>DynamicBicycle</vehicle_model>
      <yaml_config>$(arg config_file)</yaml_config>
      <update_rate>${config['dynamics']['update_rate_hz']}</update_rate>
      <control_delay>${config['dynamics']['control_delay_sec']}</control_delay>
      <steering_lock_time>1.0</steering_lock_time>
      <command_mode>velocity</command_mode>
      <use_cmd_vel>true</use_cmd_vel>
      <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <front_left_wheel_steering>left_steering_hinge_joint</front_left_wheel_steering>
      <front_right_wheel_steering>right_steering_hinge_joint</front_right_wheel_steering>
      <front_left_wheel>front_left_wheel_joint</front_left_wheel>
      <front_right_wheel>front_right_wheel_joint</front_right_wheel>
      <rear_left_wheel>rear_left_wheel_joint</rear_left_wheel>
      <rear_right_wheel>rear_right_wheel_joint</rear_right_wheel>
    </plugin>
  </gazebo>

  <!-- Remastered cone plugin (Ignition Gazebo Fortress) -->
  <gazebo>
    <plugin filename="libgazebo_ground_truth_cones.so"
            name="gazebo_plugins::eufs_plugins::GazeboGroundTruthConesRemastered">
      <updateRate>100.0</updateRate>
      <trackModelName>track</trackModelName>
      <carFrameLink>base_footprint</carFrameLink>

      <groundTruthTrackTopicName>/ground_truth/track</groundTruthTrackTopicName>
      <visibleConesTopicName>/ground_truth/cones</visibleConesTopicName>
      <trackFrame>map</trackFrame>
      <visibleFrame>base_footprint</visibleFrame>
      <publishTrack>$(arg publish_track_cones)</publishTrack>

      <cameraViewDistance>20.0</cameraViewDistance>
      <cameraMinViewDistance>0.3</cameraMinViewDistance>
      <cameraFOV>1.919862</cameraFOV>
      <lidarOn>true</lidarOn>
      <lidarViewDistance>100.0</lidarViewDistance>
      <lidarMinViewDistance>1.0</lidarMinViewDistance>
      <lidarXViewDistance>20.0</lidarXViewDistance>
      <lidarYViewDistance>20.0</lidarYViewDistance>
      <lidarFOV>3.141593</lidarFOV>

      <enableConeMiscoloring>$(arg enable_cone_miscoloring)</enableConeMiscoloring>
      <confusionMatrixYaml>$(arg cone_confusion_yaml)</confusionMatrixYaml>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>left_steering_hinge_joint</joint_name>
      <joint_name>right_steering_hinge_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>$(arg topic_prefix)/joint_states</topic>
      <update_rate>${config['dynamics']['update_rate_hz']}</update_rate>
    </plugin>
  </gazebo>

  <!-- Odometry Publisher -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>$(arg topic_prefix)/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>$(arg topic_prefix)/imu</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- NavSat/GPS Sensor -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <topic>$(arg topic_prefix)/navsat</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- Stereo Left Camera Sensor -->
  <gazebo reference="stereo_left_link">
    <sensor name="stereo_left_camera" type="camera">
      <topic>$(arg topic_prefix)/stereo/left/image_raw</topic>
      <camera_info_topic>$(arg topic_prefix)/stereo/left/camera_info</camera_info_topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <!-- ZED 2i (2.1mm lens) -->
        <horizontal_fov>1.919862</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Stereo Right Camera Sensor -->
  <gazebo reference="stereo_right_link">
    <sensor name="stereo_right_camera" type="camera">
      <topic>$(arg topic_prefix)/stereo/right/image_raw</topic>
      <camera_info_topic>$(arg topic_prefix)/stereo/right/camera_info</camera_info_topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <!-- ZED 2i (2.1mm lens) -->
        <horizontal_fov>1.919862</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Front 260-degree 2D LiDAR Sensor -->
  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <topic>$(arg topic_prefix)/lidar</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-2.26892803</min_angle>
            <max_angle>2.26892803</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
</robot>
