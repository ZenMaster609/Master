<?xml version="1.0"?>
<robot name="sim_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    ============================================================================
    Formula Student Car URDF - Estimator-Friendly Suspension Model
    ============================================================================

    Vehicle Configuration:
    - RWD drivetrain (rear wheels driven via velocity commands)
    - Ackermann front-wheel steering (position controlled)
    - Single-DOF-per-wheel suspension (vertical prismatic joints)
    - IMU and GPS sensors on chassis

    Design Philosophy:
    - Numerically stable for state estimation (EKF/UKF)
    - Simple vertical wheel travel (no multi-link kinematics)
    - Independent corners (no coupled motion or anti-roll bars)
    - Explicit spring-damper via JointController plugins

    ============================================================================
    KINEMATIC CHAIN (per wheel)
    ============================================================================

    FRONT WHEELS (steered):
      base_link
        └─> suspension_*_joint    [PRISMATIC, axis=+Z]
            │   Purpose: Vertical wheel travel (spring-damper)
            │   Travel: ±50mm, with spring k=20000 N/m, damping c=1000 Ns/m
            │
            └─> suspension_*_link
                └─> steering_*_joint  [REVOLUTE, axis=+Z]
                    │   Purpose: Steering about vertical kingpin axis
                    │   Range: ±30° (±0.52 rad)
                    │
                    └─> steering_*_link
                        └─> *_wheel_joint  [CONTINUOUS, axis=+Y]
                            │   Purpose: Free wheel rotation
                            │   (Passive, follows ground contact)
                            │
                            └─> *_wheel

    REAR WHEELS (driven, no steering):
      base_link
        └─> suspension_*_joint    [PRISMATIC, axis=+Z]
            │   Purpose: Vertical wheel travel (spring-damper)
            │   Travel: ±50mm, with spring k=20000 N/m, damping c=1000 Ns/m
            │
            └─> suspension_*_link
                └─> *_wheel_joint  [CONTINUOUS, axis=+Y]
                    │   Purpose: Driven wheel rotation
                    │   (Velocity controlled via PID)
                    │
                    └─> *_wheel

    ============================================================================
    SUSPENSION SPRING-DAMPER MODEL
    ============================================================================

    Each suspension joint uses a JointController plugin acting as spring-damper:

        F_spring = -k * (z - z_ref)     where k = P-gain = 20000 N/m
        F_damper = -c * dz/dt           where c = D-gain = 1000 Ns/m

    This provides:
    - Linear spring behavior (restoring force proportional to displacement)
    - Velocity-proportional damping (oscillation suppression)
    - Tunable parameters via topic commands or launch file

    Bump stops are implemented via joint limits:
    - Hard stop at ±50mm travel
    - Effort limit of 10000 N prevents joint breakage

    ============================================================================
    VEHICLE PARAMETERS
    ============================================================================

    Wheelbase:      1.6 m   (front to rear axle)
    Track width:    1.1 m   (left to right wheel center)
    Wheel radius:   0.23 m  (all wheels)
    Wheel width:    0.18 m (front), 0.20 m (rear)
    Chassis mass:   200 kg
    Wheel mass:     8 kg (front), 10 kg (rear)

    ============================================================================
  -->

  <!-- ============================================== -->
  <!-- Materials                                       -->
  <!-- ============================================== -->
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>

  <!-- ============================================== -->
  <!-- Vehicle Parameters (tune these)                -->
  <!-- ============================================== -->
  <!-- Chassis -->
  <!-- Wheelbase: 1.6m, Track width: 1.2m -->
  <!-- Wheel positions relative to base_link center -->

  <!-- ============================================== -->
  <!-- Base Footprint (for navigation)                -->
  <!-- ============================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- Base Link (Chassis)                            -->
  <!-- ============================================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://sim_car/meshes/sisu-20d.dae"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://sim_car/meshes/sisu-20d.dae"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="200.0"/>
      <inertia ixx="10.0" ixy="0.0" ixz="0.0" iyy="50.0" iyz="0.0" izz="50.0"/>
    </inertial>
  </link>

  <!-- ============================================== -->
  <!-- FRONT LEFT CORNER                              -->
  <!-- ============================================== -->
  <!--
    Kinematic chain: base_link -> suspension -> steering -> wheel
    This corner has steering capability (Ackermann geometry).
  -->

  <!-- FL Suspension Link
       Represents the suspension upright/knuckle assembly.
       Moves vertically relative to chassis via prismatic joint.
       Mass includes upright, hub carrier, and brake assembly.
  -->
  <link name="suspension_fl_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- No collision - suspension link is internal mechanism -->
    <inertial>
      <mass value="2.0"/>
      <!-- Manually defined inertia for upright assembly -->
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- FL Suspension Joint (PRISMATIC)
       Purpose: Single-DOF vertical wheel travel
       Axis: +Z (pure vertical motion in wheel frame)
       Travel: ±50mm (bump stops at limits)
       Spring-damper: Implemented via JointController plugin (see Gazebo plugins section)
         - Spring stiffness k = 20000 N/m (via P-gain)
         - Damping coefficient c = 1000 Ns/m (via D-gain)
       Note: Damping here is backup; primary damping from controller plugin
  -->
  <joint name="suspension_fl_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_fl_link"/>
    <!-- Position: front-left corner, 0.8m forward, 0.55m left, 0.1m below chassis CG -->
    <origin xyz="0.8 0.55 -0.1" rpy="0 0 0"/>
    <!-- Axis aligned with vehicle +Z (pure vertical travel) -->
    <axis xyz="0 0 1"/>
    <!-- Limits act as bump stops: ±50mm travel, 10kN max force -->
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <!-- Backup damping if controller fails; primary spring-damper via plugin -->
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- FL Steering Link
       Represents the steering arm/tie rod connection point.
       Rotates about vertical axis to steer the wheel.
  -->
  <link name="steering_fl_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- FL Steering Joint (REVOLUTE)
       Purpose: Front wheel steering about vertical kingpin axis
       Axis: +Z (vertical steering axis)
       Range: ±30° (±0.52 rad) for Ackermann geometry
       Controlled via position commands from ackermann_control_node
  -->
  <joint name="steering_fl_joint" type="revolute">
    <parent link="suspension_fl_link"/>
    <child link="steering_fl_link"/>
    <!-- Steering axis below suspension link -->
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <!-- Vertical steering axis (kingpin) -->
    <axis xyz="0 0 1"/>
    <!-- ±30° steering range, 100 Nm torque limit -->
    <limit lower="-0.52" upper="0.52" effort="100" velocity="3.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- FL Wheel
       Simple cylinder collision geometry for stable simulation.
       Visual can use mesh for appearance (not included in base model).
       Inertia manually calculated for solid cylinder.
  -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_left.dae"/>
      </geometry>
      <material name="black"/>
      <!-- Rotate cylinder so Y-axis becomes rotation axis -->
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_left.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <!-- Manually calculated inertia for 8kg solid cylinder
           Ixx = Iyy = (1/12)*m*(3r² + h²) = 0.1
           Izz = (1/2)*m*r² = 0.17 -->
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.17"/>
    </inertial>
  </link>

  <!-- FL Wheel Joint (CONTINUOUS)
       Purpose: Free wheel rotation (passive, driven by ground contact)
       Axis: +Y (lateral axis for forward rolling)
       Not controlled - follows ground contact forces
  -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="steering_fl_link"/>
    <child link="front_left_wheel"/>
    <!-- Wheel center offset from steering axis -->
    <origin xyz="0 0.05 -0.08" rpy="0 0 0"/>
    <!-- Rotation about Y-axis (lateral) for forward motion -->
    <axis xyz="0 1 0"/>
    <!-- Low damping/friction for free rolling -->
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- FRONT RIGHT CORNER                             -->
  <!-- ============================================== -->
  <!--
    Kinematic chain: base_link -> suspension -> steering -> wheel
    Mirror of FL corner with steering capability.
  -->

  <!-- FR Suspension Link (see FL for detailed description) -->
  <link name="suspension_fr_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- FR Suspension Joint (PRISMATIC)
       Same as FL: vertical travel with spring-damper via controller plugin -->
  <joint name="suspension_fr_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_fr_link"/>
    <!-- Position: front-right corner, 0.8m forward, 0.55m right -->
    <origin xyz="0.8 -0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- FR Steering Link -->
  <link name="steering_fr_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- FR Steering Joint (REVOLUTE)
       Outer wheel in Ackermann geometry (turns less than inner wheel) -->
  <joint name="steering_fr_joint" type="revolute">
    <parent link="suspension_fr_link"/>
    <child link="steering_fr_link"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="100" velocity="3.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- FR Wheel (see FL for detailed inertia calculation) -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_right.dae"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_right.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.17"/>
    </inertial>
  </link>

  <!-- FR Wheel Joint (CONTINUOUS) - passive rolling -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="steering_fr_link"/>
    <child link="front_right_wheel"/>
    <!-- Offset to right side (-Y) -->
    <origin xyz="0 -0.05 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- REAR LEFT CORNER (DRIVE WHEEL)                 -->
  <!-- ============================================== -->
  <!--
    Kinematic chain: base_link -> suspension -> wheel (NO STEERING)
    Rear wheels are driven via velocity commands (RWD architecture).
    Simpler than front corners - no steering joint in chain.
  -->

  <!-- RL Suspension Link -->
  <link name="suspension_rl_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- RL Suspension Joint (PRISMATIC)
       Pure vertical travel, no steering DOF on rear axle.
       Spring-damper via controller plugin. -->
  <joint name="suspension_rl_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_rl_link"/>
    <!-- Position: rear-left corner, 0.8m back, 0.55m left -->
    <origin xyz="-0.8 0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- RL Wheel (DRIVE)
       Driven wheel - receives velocity commands from ackermann_control_node.
       Wider than front wheels (0.20m vs 0.18m) for better traction.
       Heavier (10kg vs 8kg) to account for drive components.
       NOTE: No steering joint - rear axle has no steering DOF.
  -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_left.dae"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_left.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <!-- Heavier wheel (10kg) including hub/brake/CV joint -->
      <mass value="10.0"/>
      <!-- Manually calculated inertia for 10kg solid cylinder
           Ixx = Iyy = (1/12)*m*(3r² + h²) = 0.12
           Izz = (1/2)*m*r² = 0.21 -->
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.21"/>
    </inertial>
  </link>

  <!-- RL Wheel Joint (CONTINUOUS)
       DRIVEN wheel - controlled via JointController plugin.
       Receives velocity commands via /sim/rear_left_wheel_cmd topic. -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="suspension_rl_link"/>
    <child link="rear_left_wheel"/>
    <!-- Wheel directly attached to suspension (no steering link) -->
    <origin xyz="0 0.05 -0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- REAR RIGHT CORNER (DRIVE WHEEL)                -->
  <!-- ============================================== -->
  <!--
    Kinematic chain: base_link -> suspension -> wheel (NO STEERING)
    Mirror of RL corner - driven wheel, no steering.
  -->

  <!-- RR Suspension Link -->
  <link name="suspension_rr_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- RR Suspension Joint (PRISMATIC) - same as RL -->
  <joint name="suspension_rr_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_rr_link"/>
    <!-- Position: rear-right corner, 0.8m back, 0.55m right -->
    <origin xyz="-0.8 -0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- RR Wheel (DRIVE) - No steering joint -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_right.dae"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://sim_car/meshes/wheel_right.dae"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.21"/>
    </inertial>
  </link>

  <!-- RR Wheel Joint (CONTINUOUS)
       DRIVEN wheel - controlled via JointController plugin.
       Receives velocity commands via /sim/rear_right_wheel_cmd topic. -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="suspension_rr_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.05 -0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- IMU Sensor Link                                -->
  <!-- ============================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- GPS Sensor Link                                -->
  <!-- ============================================== -->
  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.5 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- Ignition Gazebo Fortress Plugins               -->
  <!-- ============================================== -->
  <!--
    Plugin Summary:
    - EUFS dynamics system: Kinematic vehicle model (DynamicBicycle/PointMass)
    - JointStatePublisher: Reports joint positions/velocities at 100Hz
    - OdometryPublisher: Base link pose/twist at 50Hz
    - IMU sensor: 50Hz with Gaussian noise
    - NavSat sensor: 50Hz GPS with position noise

    All topics use /sim/ namespace to distinguish from real hardware.
  -->

  <!-- Wheel friction for stable tire-ground contact -->
  <gazebo reference="front_left_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.2</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.2</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>

  <!-- EUFS dynamics plugin (kinematic vehicle model) -->
  <gazebo>
    <plugin filename="libeufs_gz_dynamics.so"
            name="eufs_gz_dynamics::EufsRaceCarModel">
      <vehicle_model>DynamicBicycle</vehicle_model>
      <yaml_config>__EUFS_CONFIG_PATH__</yaml_config>
      <update_rate>1000.0</update_rate>
      <control_delay>0.0</control_delay>
      <steering_lock_time>1.0</steering_lock_time>
      <command_mode>velocity</command_mode>
      <use_cmd_vel>true</use_cmd_vel>
      <cmd_vel_topic>/cmd_vel</cmd_vel_topic>
      <front_left_wheel_steering>steering_fl_joint</front_left_wheel_steering>
      <front_right_wheel_steering>steering_fr_joint</front_right_wheel_steering>
      <front_left_wheel>front_left_wheel_joint</front_left_wheel>
      <front_right_wheel>front_right_wheel_joint</front_right_wheel>
      <rear_left_wheel>rear_left_wheel_joint</rear_left_wheel>
      <rear_right_wheel>rear_right_wheel_joint</rear_right_wheel>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher - publishes all joint positions/velocities -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <!-- Wheel rotation joints -->
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <!-- Steering joints -->
      <joint_name>steering_fl_joint</joint_name>
      <joint_name>steering_fr_joint</joint_name>
      <!-- Suspension joints -->
      <joint_name>suspension_fl_joint</joint_name>
      <joint_name>suspension_fr_joint</joint_name>
      <joint_name>suspension_rl_joint</joint_name>
      <joint_name>suspension_rr_joint</joint_name>
      <topic>/sim/joint_states</topic>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

  <!-- Odometry Publisher using pose/twist of base_link -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/sim/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/sim/imu</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- NavSat/GPS Sensor -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <topic>/sim/navsat</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

</robot>
