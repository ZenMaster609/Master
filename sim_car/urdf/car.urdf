<?xml version="1.0"?>
<robot name="sim_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Formula Student Car URDF with:
    - RWD drivetrain (rear wheels driven)
    - Ackermann front-wheel steering
    - Per-wheel independent suspension (prismatic joints)
    - IMU and GPS sensors

    Joint hierarchy:
      base_link
        -> suspension_*_joint (prismatic, Z-axis)
          -> suspension_*_link
            -> [steering_*_joint (revolute, Z-axis)] (front only)
              -> [steering_*_link] (front only)
                -> *_wheel_joint (continuous, Y-axis)
                  -> *_wheel
  -->

  <!-- ============================================== -->
  <!-- Materials                                       -->
  <!-- ============================================== -->
  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>

  <!-- ============================================== -->
  <!-- Vehicle Parameters (tune these)                -->
  <!-- ============================================== -->
  <!-- Chassis -->
  <!-- Wheelbase: 1.6m, Track width: 1.2m -->
  <!-- Wheel positions relative to base_link center -->

  <!-- ============================================== -->
  <!-- Base Footprint (for navigation)                -->
  <!-- ============================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- Base Link (Chassis)                            -->
  <!-- ============================================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="2.0 0.8 0.15"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="2.0 0.8 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="200.0"/>
      <inertia ixx="10.0" ixy="0.0" ixz="0.0" iyy="50.0" iyz="0.0" izz="50.0"/>
    </inertial>
  </link>

  <!-- ============================================== -->
  <!-- FRONT LEFT CORNER                              -->
  <!-- ============================================== -->

  <!-- FL Suspension -->
  <link name="suspension_fl_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="suspension_fl_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_fl_link"/>
    <origin xyz="0.8 0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- FL Steering -->
  <link name="steering_fl_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="steering_fl_joint" type="revolute">
    <parent link="suspension_fl_link"/>
    <child link="steering_fl_link"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="100" velocity="3.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- FL Wheel -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.23" length="0.18"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.23" length="0.18"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.17"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="steering_fl_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0.05 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- FRONT RIGHT CORNER                             -->
  <!-- ============================================== -->

  <!-- FR Suspension -->
  <link name="suspension_fr_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="suspension_fr_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_fr_link"/>
    <origin xyz="0.8 -0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- FR Steering -->
  <link name="steering_fr_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="steering_fr_joint" type="revolute">
    <parent link="suspension_fr_link"/>
    <child link="steering_fr_link"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="100" velocity="3.0"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- FR Wheel -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.23" length="0.18"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.23" length="0.18"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.17"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="steering_fr_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 -0.05 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- REAR LEFT CORNER (DRIVE WHEEL)                 -->
  <!-- ============================================== -->

  <!-- RL Suspension -->
  <link name="suspension_rl_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="suspension_rl_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_rl_link"/>
    <origin xyz="-0.8 0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- RL Wheel (DRIVE) - No steering joint -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.23" length="0.20"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.23" length="0.20"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.21"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="suspension_rl_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0.05 -0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- REAR RIGHT CORNER (DRIVE WHEEL)                -->
  <!-- ============================================== -->

  <!-- RR Suspension -->
  <link name="suspension_rr_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="suspension_rr_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="suspension_rr_link"/>
    <origin xyz="-0.8 -0.55 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.05" upper="0.05" effort="10000" velocity="1.0"/>
    <dynamics damping="1000.0" friction="10.0"/>
  </joint>

  <!-- RR Wheel (DRIVE) - No steering joint -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.23" length="0.20"/>
      </geometry>
      <material name="black"/>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.23" length="0.20"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.21"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="suspension_rr_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.05 -0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================== -->
  <!-- IMU Sensor Link                                -->
  <!-- ============================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- GPS Sensor Link                                -->
  <!-- ============================================== -->
  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.5 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- Ignition Gazebo Fortress Plugins               -->
  <!-- All topics use /sim/ namespace                 -->
  <!-- ============================================== -->

  <!-- Wheel friction for all wheels -->
  <gazebo reference="front_left_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.2</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.2</mu2>
    <slip1>0.001</slip1>
    <slip2>0.001</slip2>
  </gazebo>

  <!-- Joint State Publisher - publishes all joint positions/velocities -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <!-- Wheel rotation joints -->
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <!-- Steering joints -->
      <joint_name>steering_fl_joint</joint_name>
      <joint_name>steering_fr_joint</joint_name>
      <!-- Suspension joints -->
      <joint_name>suspension_fl_joint</joint_name>
      <joint_name>suspension_fr_joint</joint_name>
      <joint_name>suspension_rl_joint</joint_name>
      <joint_name>suspension_rr_joint</joint_name>
      <topic>/sim/joint_states</topic>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

  <!-- Rear Left Wheel Velocity Controller (DRIVE) -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/sim/rear_left_wheel_cmd</topic>
      <p_gain>50.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
  </gazebo>

  <!-- Rear Right Wheel Velocity Controller (DRIVE) -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/sim/rear_right_wheel_cmd</topic>
      <p_gain>50.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
  </gazebo>

  <!-- Front Left Steering Position Controller -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
      <joint_name>steering_fl_joint</joint_name>
      <use_velocity_commands>false</use_velocity_commands>
      <topic>/sim/steering_fl_cmd</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>10.0</d_gain>
    </plugin>
  </gazebo>

  <!-- Front Right Steering Position Controller -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
      <joint_name>steering_fr_joint</joint_name>
      <use_velocity_commands>false</use_velocity_commands>
      <topic>/sim/steering_fr_cmd</topic>
      <p_gain>100.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>10.0</d_gain>
    </plugin>
  </gazebo>

  <!-- Odometry Publisher using pose/twist of base_link -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/sim/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/sim/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- NavSat/GPS Sensor -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <topic>/sim/navsat</topic>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

</robot>
