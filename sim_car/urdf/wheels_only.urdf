<?xml version="1.0"?>
<robot name="wheels_only">
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Outer wheel diameter: 520 mm (radius 0.26 m). Edit length as needed. -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="file:///home/aleks/ros2_ws/src/Master/sim_meshes/wheels/fl/fl.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="file:///home/aleks/ros2_ws/src/Master/sim_meshes/wheels/fr/fr.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="file:///home/aleks/ros2_ws/src/Master/sim_meshes/wheels/rl/rl.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <mesh filename="file:///home/aleks/ros2_ws/src/Master/sim_meshes/wheels/rr/rr.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.26" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- All wheels fixed at origin, no collision geometry. -->
  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
