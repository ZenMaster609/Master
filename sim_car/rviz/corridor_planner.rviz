Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Cone Memory1
        - /Planner Debug1
        - /Skidpad Router1
        - /Planned Centerline1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.4
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.8
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /sim/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 64; 64
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Cone Memory
      Enabled: true
      Topic:
        Value: /local_cone_map_viz
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Global Track Hypothesis
      Enabled: false
      Topic:
        Value: /cone_memory/believed_track_viz
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 100
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Planner Debug
      Enabled: true
      Topic:
        Value: /planner_viz
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        boundary_left: true
        boundary_left_points: true
        boundary_right: true
        boundary_right_points: true
        centerline: false
        corridor_center_anchors: true
        corridor_pair_audit_labels: true
        corridor_pair_audit_pair_left_behind: true
        corridor_pair_audit_pair_left_beyond_horizon: true
        corridor_pair_audit_pair_nonfinite: true
        corridor_pair_audit_pair_not_in_longest_valid_slice: true
        corridor_pair_audit_pair_rejected_unknown: true
        corridor_pair_audit_pair_right_behind: true
        corridor_pair_audit_pair_right_beyond_horizon: true
        corridor_pair_audit_pair_width_too_narrow: true
        corridor_pair_audit_pair_width_too_wide: true
        corridor_rungs: true
        lookahead: true
        raw_chain_left: true
        raw_chain_left_points: true
        raw_chain_right: true
        raw_chain_right_points: true
        raw_prevalidation_centerline: false
        remembered_cones: false
        status: true
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Corridor Cone Audit
      Enabled: true
      Topic:
        Value: /corridor_planner/cone_audit_viz
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        cone_audit_labels: true
        cone_audit_chain_rejected: true
        cone_audit_rejected_color: true
        cone_audit_rejected_confidence: true
        cone_audit_rejected_geometry: true
        cone_audit_rejected_other: true
        cone_audit_stale_halo: true
        cone_audit_used_left_chain: true
        cone_audit_used_right_chain: true
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Skidpad Router
      Enabled: true
      Topic:
        Value: /skidpad_router/markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Planned Centerline
      Enabled: true
      Topic:
        Value: /planned_centerline
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Buffer Length: 1
      Color: 255; 64; 64
      Line Style: Billboards
      Line Width: 0.20
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 85
      Pose Style: None
      Radius: 0.03
      Shaft Length: 0.05
      Shaft Radius: 0.01
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Raw Lidar Debug
      Enabled: false
      Topic:
        Value: /local_cone_map_viz/raw_lidar
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 50
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Raw Camera Debug
      Enabled: false
      Topic:
        Value: /local_cone_map_viz/raw_camera
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 50
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 3.14
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
Window Geometry:
  Height: 1000
  Width: 1800
  X: 60
  Y: 25
  Hide Left Dock: false
  Hide Right Dock: false
